{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.5.2",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.bilivideo.com/*"
  ],
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bilibili_cdn_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
